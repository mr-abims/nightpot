{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    // ../src/witnesses.ts is shared with the Node scripts; resolve its imports from web/node_modules,
    // since hosted builds (Vercel, Root Directory = web) install only the web app's dependencies.
    "paths": {
      "@midnight-ntwrk/compact-runtime": ["./node_modules/@midnight-ntwrk/compact-runtime"]
    }
  },
  "include": ["src"]
}
