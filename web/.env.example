# Network the app targets. Lace must be on the same network.
VITE_NETWORK_ID=preprod

# Optional: a pot to open by default (hex contract address).
VITE_POT_ADDRESS=

# Used to read pot state before a wallet is connected.
VITE_INDEXER_URI=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Fallback prover if the wallet does not report one.
VITE_PROOF_SERVER_URI=http://localhost:6300
