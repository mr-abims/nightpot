# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Wallet seed (sensitive)
# Owner secret key for the counter contract — the one thing that must never
# be committed. Only its hash belongs on-chain.
.midnight-owner-key

# Deployment info
deployment.json

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state — the LevelDB store holding the contract's private state
# (the owner's secret key). Never commit it.
*-state/
midnight-level-db/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses)
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

# NightPot spike output
spike-result.json
managed/
web/node_modules/
web/dist/
web/public/zk/

# NightPot web build artifacts
web/public/keys/
web/public/zkir/
web/src/generated/
web/.vite/
