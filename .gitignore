.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state — the LevelDB store holding the contract's private state
# (the owner's secret key). Never commit it.
*-state/
midnight-level-db/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses)
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

# NightPot end-to-end run output
e2e-result.json
spike-result.json
managed/
web/node_modules/
web/dist/
web/public/zk/

# NightPot web build artifacts (compiled keys and contract under web/ are committed for hosted builds)
web/.vite/

# Contract work-in-progress while the Preprod run uses managed/
.dev-dl/
spike.log
spike-local.log
e2e.log
e2e-local.log

